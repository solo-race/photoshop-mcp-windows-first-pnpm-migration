{
  "name": "photoshop-mcp-windows-first",
  "version": "0.1.2",
  "description": "Project-scoped Photoshop MCP with restricted tools and local-only previews",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "photoshop-mcp": "dist/index.js"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [
    "mcp",
    "photoshop",
    "adobe",
    "automation",
    "ai",
    "model-context-protocol",
    "image-editing"
  ],
  "author": "rookietopred02-gif",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solo-race/photoshop-mcp-windows-first-pnpm-migration.git"
  },
  "bugs": {
    "url": "https://github.com/solo-race/photoshop-mcp-windows-first-pnpm-migration/issues"
  },
  "homepage": "https://github.com/solo-race/photoshop-mcp-windows-first-pnpm-migration",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.18.3",
  "private": true
}
